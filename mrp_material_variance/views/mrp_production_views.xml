<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_material_variance" model="ir.ui.view">
        <field name="name">mrp.production.form.material.variance</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_material_variance"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-balance-scale"
                        groups="mrp.group_mrp_user"
                        invisible="state in ('draft', 'cancel')">
                    <field name="material_variance_count" widget="statinfo" string="Material Variance"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
