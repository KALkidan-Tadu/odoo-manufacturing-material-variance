<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_material_variance_list" model="ir.ui.view">
        <field name="name">mrp.material.variance.list</field>
        <field name="model">mrp.material.variance</field>
        <field name="arch" type="xml">
            <list string="Material Variances"
                  decoration-danger="classification == 'over'"
                  decoration-warning="classification == 'under'"
                  decoration-success="classification == 'within'"
                  decoration-muted="is_provisional">
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="component_id"/>
                <field name="planned_qty"/>
                <field name="actual_qty"/>
                <field name="variance_qty"/>
                <field name="variance_percent"/>
                <field name="tolerance_percent" optional="hide"/>
                <field name="classification"/>
                <field name="production_state" optional="show"/>
                <field name="is_provisional" optional="show"/>
                <field name="product_uom_id" groups="uom.group_uom" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_mrp_material_variance_form" model="ir.ui.view">
        <field name="name">mrp.material.variance.form</field>
        <field name="model">mrp.material.variance</field>
        <field name="arch" type="xml">
            <form string="Material Variance" create="0" edit="0">
                <header>
                    <field name="classification" widget="badge"
                             decoration-danger="classification == 'over'"
                             decoration-warning="classification == 'under'"
                             decoration-success="classification == 'within'"/>
                    <field name="is_provisional" invisible="1"/>
                    <div class="alert alert-warning" role="alert" invisible="not is_provisional">
                        This analysis is provisional because the manufacturing order is not done yet.
                        Actual consumption may still change.
                    </div>
                </header>
                <sheet>
                    <group>
                        <group string="Manufacturing">
                            <field name="production_id"/>
                            <field name="product_id"/>
                            <field name="production_state"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Component">
                            <field name="component_id"/>
                            <field name="product_uom_id" groups="uom.group_uom"/>
                        </group>
                    </group>
                    <group string="Quantities">
                        <group>
                            <field name="planned_qty"/>
                            <field name="actual_qty"/>
                            <field name="variance_qty"/>
                        </group>
                        <group>
                            <field name="variance_percent"/>
                            <field name="tolerance_percent"/>
                            <field name="has_consumption_data"/>
                        </group>
                    </group>
                    <group string="Source Moves" groups="base.group_no_one">
                        <field name="stock_move_ids" nolabel="1" colspan="2">
                            <list>
                                <field name="product_id"/>
                                <field name="product_uom_qty" string="To Consume"/>
                                <field name="quantity" string="Quantity"/>
                                <field name="picked"/>
                                <field name="state"/>
                                <field name="product_uom"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mrp_material_variance_search" model="ir.ui.view">
        <field name="name">mrp.material.variance.search</field>
        <field name="model">mrp.material.variance</field>
        <field name="arch" type="xml">
            <search string="Material Variances">
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="component_id"/>
                <field name="classification"/>
                <field name="production_state"/>
                <separator/>
                <filter string="Overconsumption" name="overconsumption"
                        domain="[('classification', '=', 'over')]"/>
                <filter string="Underconsumption" name="underconsumption"
                        domain="[('classification', '=', 'under')]"/>
                <filter string="Within Tolerance" name="within_tolerance"
                        domain="[('classification', '=', 'within')]"/>
                <filter string="Exceeding Tolerance" name="exceeding"
                        domain="[('classification', 'in', ('over', 'under'))]"/>
                <filter string="Provisional" name="provisional"
                        domain="[('is_provisional', '=', True)]"/>
                <filter string="Final (MO Done)" name="final"
                        domain="[('is_provisional', '=', False)]"/>
                <separator/>
                <filter string="MO Confirmed" name="mo_confirmed"
                        domain="[('production_state', '=', 'confirmed')]"/>
                <filter string="MO In Progress" name="mo_progress"
                        domain="[('production_state', '=', 'progress')]"/>
                <filter string="MO To Close" name="mo_to_close"
                        domain="[('production_state', '=', 'to_close')]"/>
                <filter string="MO Done" name="mo_done"
                        domain="[('production_state', '=', 'done')]"/>
                <separator/>
                <group>
                    <filter string="Manufacturing Order" name="group_production"
                            context="{'group_by': 'production_id'}"/>
                    <filter string="Component" name="group_component"
                            context="{'group_by': 'component_id'}"/>
                    <filter string="Classification" name="group_classification"
                            context="{'group_by': 'classification'}"/>
                    <filter string="Finished Product" name="group_product"
                            context="{'group_by': 'product_id'}"/>
                    <filter string="MO Status" name="group_mo_state"
                            context="{'group_by': 'production_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_mrp_material_variance_pivot" model="ir.ui.view">
        <field name="name">mrp.material.variance.pivot</field>
        <field name="model">mrp.material.variance</field>
        <field name="arch" type="xml">
            <pivot string="Material Variances" sample="1">
                <field name="production_id" type="row"/>
                <field name="classification" type="col"/>
                <field name="variance_qty" type="measure"/>
                <field name="variance_percent" type="measure"/>
                <field name="planned_qty" type="measure"/>
                <field name="actual_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_mrp_material_variance_graph" model="ir.ui.view">
        <field name="name">mrp.material.variance.graph</field>
        <field name="model">mrp.material.variance</field>
        <field name="arch" type="xml">
            <graph string="Material Variances" type="bar" sample="1">
                <field name="classification"/>
                <field name="variance_qty" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_mrp_material_variance" model="ir.actions.act_window">
        <field name="name">Material Variances</field>
        <field name="res_model">mrp.material.variance</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_mrp_material_variance_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No material variance lines yet
            </p>
            <p>
                Confirm manufacturing orders with components, then open this menu
                or the Material Variance smart button on a manufacturing order.
            </p>
        </field>
    </record>

    <record id="action_mrp_material_variance_menu" model="ir.actions.server">
        <field name="name">Material Variances</field>
        <field name="model_id" ref="model_mrp_material_variance"/>
        <field name="state">code</field>
        <field name="code">
action = model.action_open_variance_analysis()
        </field>
    </record>

    <record id="view_mrp_material_variance_dashboard_form" model="ir.ui.view">
        <field name="name">mrp.material.variance.dashboard.form</field>
        <field name="model">mrp.material.variance.dashboard</field>
        <field name="arch" type="xml">
            <form string="Material Variance Summary" create="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1>Material Variance Summary</h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="tolerance_percent"/>
                        </group>
                    </group>
                    <group string="Overview">
                        <group>
                            <field name="mo_count"/>
                            <field name="component_exceeding_count"/>
                            <field name="provisional_count"/>
                        </group>
                        <group>
                            <field name="overconsumption_count"/>
                            <field name="underconsumption_count"/>
                            <field name="within_tolerance_count"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_refresh" type="object" string="Refresh" class="btn-secondary"/>
                        <button name="action_open_variances" type="object" string="Open Variances" class="btn-primary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mrp_material_variance_dashboard" model="ir.actions.act_window">
        <field name="name">Variance Summary</field>
        <field name="res_model">mrp.material.variance.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{}</field>
    </record>
</odoo>
